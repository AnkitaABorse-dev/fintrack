@baseUrl = http://localhost:5000/api

### 1. Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "name": "Test User", "email": "test@example.com", "password": "Password123" }

### 2. Register with a too-short password
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "name": "Short Pass", "email": "short@example.com", "password": "123" }

### 3. Login with the wrong password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "test@example.com", "password": "WrongPassword" }

### 4. Login correctly
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "test@example.com", "password": "Password123" }

### 5. Who am I, with the real token
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}

### 6. Who am I, with no token
GET {{baseUrl}}/auth/me

### 7. Who am I, with a fake token
GET {{baseUrl}}/auth/me
Authorization: Bearer abc.def.ghi

### 8. Add an expense
# @name addExpense
POST {{baseUrl}}/transactions
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "title": "Groceries", "amount": 4200, "type": "expense", "category": "Food", "date": "2026-11-08" }

### 9. Add with a negative amount
POST {{baseUrl}}/transactions
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "title": "Bad", "amount": -5, "type": "expense", "category": "Food", "date": "2026-11-08" }

### 10. Add with an unknown category
POST {{baseUrl}}/transactions
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "title": "Bad", "amount": 50, "type": "expense", "category": "Pizza", "date": "2026-11-08" }

### 11. List my transactions
GET {{baseUrl}}/transactions
Authorization: Bearer {{login.response.body.token}}

### 12. List with no token
GET {{baseUrl}}/transactions

### 13. Register a second user
# @name other
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "name": "Other User", "email": "other@example.com", "password": "Password123" }

### 14. Second user lists transactions (should be empty)
GET {{baseUrl}}/transactions
Authorization: Bearer {{otherLogin.response.body.token}}

### 15. Second user tries to delete the first user's transaction
DELETE {{baseUrl}}/transactions/{{addExpense.response.body.id}}
Authorization: Bearer {{otherLogin.response.body.token}}

### 16. First user deletes their own transaction
DELETE {{baseUrl}}/transactions/{{addExpense.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

### 17. Delete again (already gone)
DELETE {{baseUrl}}/transactions/{{addExpense.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

### 18. Set a Food limit
PUT {{baseUrl}}/budgets/Food
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "limit": 5000 }

### 19. Change the Food limit
PUT {{baseUrl}}/budgets/Food
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "limit": 6000 }

### 20. List my budgets
GET {{baseUrl}}/budgets
Authorization: Bearer {{login.response.body.token}}

### 21. Unknown category
PUT {{baseUrl}}/budgets/Pizza
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "limit": 1000 }

### 22. Negative limit
PUT {{baseUrl}}/budgets/Food
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "limit": -5 }

### 23. No token
GET {{baseUrl}}/budgets

### 13b. Log in as the second user
# @name otherLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "other@example.com", "password": "Password123" }

### 24. Second user's budgets (should be empty)
GET {{baseUrl}}/budgets
Authorization: Bearer {{otherLogin.response.body.token}}

### 25. Delete the Food limit
DELETE {{baseUrl}}/budgets/Food
Authorization: Bearer {{login.response.body.token}}

### 26. List again (should be empty)
GET {{baseUrl}}/budgets
Authorization: Bearer {{login.response.body.token}}